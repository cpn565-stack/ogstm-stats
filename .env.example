# 公開網址（用於 metadata、匯出連結等）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 子路徑前綴。子網域部署留空；掛在 ogstm.com/stats 時設為 /stats
NEXT_PUBLIC_BASE_PATH=

# 主站網址（公開頁連結用）
NEXT_PUBLIC_MAIN_SITE_URL=https://ogstm.com

# 後台登入（上線必填）
ADMIN_PASSWORD=change-me-to-strong-password
ADMIN_SESSION_SECRET=change-me-to-random-secret

# --- 部署範例 ---
#
# 方案 A：stats.ogstm.com
# NEXT_PUBLIC_SITE_URL=https://stats.ogstm.com
# NEXT_PUBLIC_BASE_PATH=
#
# 方案 B：ogstm.com/stats
# NEXT_PUBLIC_SITE_URL=https://ogstm.com
# NEXT_PUBLIC_BASE_PATH=/stats