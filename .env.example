# 公開網址（用於 metadata、匯出連結等）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 子路徑前綴。ogstm.spq.tw 根網域部署留空
NEXT_PUBLIC_BASE_PATH=

# 主站網址（公開頁連結用）
NEXT_PUBLIC_MAIN_SITE_URL=https://ogstm.com

# 後台登入（上線必填）
ADMIN_PASSWORD=change-me-to-strong-password
ADMIN_SESSION_SECRET=change-me-to-random-secret

# LLM 辨識 provider：vertex | openrouter
LLM_PROVIDER=vertex
NEXT_PUBLIC_LLM_PROVIDER=vertex

# OpenRouter（拍照 AI 辨識，伺服器端 only）
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Vertex AI Gemini（OAuth ADC，伺服器端 only）
GOOGLE_CLOUD_PROJECT=ogstm-input
GOOGLE_CLOUD_LOCATION=asia-southeast1
VERTEX_GEMINI_MODEL=gemini-3.5-flash
GOOGLE_APPLICATION_CREDENTIALS=
# 或直接貼 ADC JSON 內容（VPS 可用）
# GOOGLE_ADC_JSON=
# 本機開發若已 gcloud login，可設 1 用 CLI token
# GOOGLE_USE_GCLOUD_CLI=1

# --- 部署範例（ogstm.spq.tw，根網域）---
# NEXT_PUBLIC_SITE_URL=https://ogstm.spq.tw
# NEXT_PUBLIC_BASE_PATH=